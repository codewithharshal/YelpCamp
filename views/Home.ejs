<% layout("layouts/boilerplate") %>
<link rel="stylesheet" href="/stylesheets/home.css" />
<!-- Hero Section -->
<header
  class="text-light text-center"
  style="
    background: url('/images/main_img.jpg') no-repeat center center/cover;
    height: 90vh;
    display: flex;
    align-items: center;
    justify-content: center;
  "
>
  <div class="container">
    <h1 class="display-4">Explore the Best Campgrounds</h1>
    <p class="lead">
      Discover, share, and enjoy beautiful campsites around the world.
    </p>
    <a href="/campgrounds" class="btn btn-primary btn-lg">Browse Camps</a>
  </div>
</header>

<!-- About Section -->
<section class="container py-5">
  <div class="row align-items-center">
    <div class="col-md-6 about-content">
      <h2 class="fw-bold text-black">About Campgrounds</h2>
      <p class="lead">
        We bring together nature lovers and campers to share and explore the
        best camping spots worldwide.
      </p>
      <p>
        Find breathtaking locations, read reviews, and plan your next outdoor
        adventure with ease.
      </p>
      <a href="/campgrounds" class="btn btn-outline-primary mt-3"
        >Explore Now</a
      >
    </div>

    <div class="col-md-6">
      <img src="/images/camp_img.jpg" class="img-fluid rounded" alt="Camping" />
    </div>
  </div>
</section>

<!-- Features Section -->
<section class="bg-light py-5">
  <div class="container text-center">
    <h2>Why Choose Us?</h2>
    <div class="row mt-4">
      <div class="col-md-4">
        <img
          src="/images/travel.jpg"
          class="feature-img mb-3"
          alt="Easy Search"
        />
        <h4>Easy Search</h4>
        <p>Find the best campgrounds with detailed descriptions and reviews.</p>
      </div>
      <div class="col-md-4">
        <img
          src="/images/Community.jpg"
          class="feature-img mb-3"
          alt="Community Driven"
        />
        <h4>Community Driven</h4>
        <p>Connect with fellow campers and share your experiences.</p>
      </div>
      <div class="col-md-4">
        <img
          src="/images/verified_location.jpg"
          class="feature-img mb-3"
          alt="Verified Locations"
        />
        <h4>Verified Locations</h4>
        <p>All listed campsites are reviewed by real campers.</p>
      </div>
    </div>
  </div>
</section>

<!-- Call to Action -->
<section class="text-center py-5">
  <div class="container">
    <h2>Ready to Explore?</h2>
    <p>Join our community today and start your adventure.</p>
    <a href="/register" class="btn btn-success btn-lg">Sign Up Now</a>
  </div>
</section>
